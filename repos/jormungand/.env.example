SITE_AUTH_USERNAME=admin
SITE_AUTH_PASSWORD=replace-with-a-long-random-password
SITE_AUTH_MODE=all
# Optional override; defaults to .harness/bridge.config.json on the bridge device.
BRIDGE_CONFIG_PATH=.harness/bridge.config.json
GITHUB_TOKEN=ghp_replace_with_repo_creation_token
GITHUB_REPOSITORY_VISIBILITY=private
JORMUNGAND_REPOSITORY=owner/repository
CODEX_BRIDGE_URL=https://codex-bridge.example.com
CODEX_BRIDGE_TOKEN=replace-with-codex-bridge-token
OPENCLAW_BRIDGE_URL=https://openclaw-bridge.example.com
OPENCLAW_BRIDGE_TOKEN=replace-with-openclaw-bridge-token
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
# Same-device Lucky / MiniMax runtime behind codex-bridge.
# Jormungand uses CODEX_BRIDGE_URL for Mavis; codex-bridge forwards
# Mavis requests to this loopback runtime on the same device.
LUCKY_BRIDGE_URL=http://127.0.0.1:4198
LUCKY_BRIDGE_TOKEN=replace-with-lucky-runtime-token
# Shared full-access contract.
# Full mode also bypasses workflow approval gates and keeps managed approval
# actions in audit without parking the run.
# Set restricted to preserve approval-gated workflow and manager behavior.
# Site Basic Auth remains enabled.
JORMUNGAND_AGENT_PERMISSION_MODE=full
