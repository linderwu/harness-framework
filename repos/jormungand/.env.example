SITE_AUTH_USERNAME=admin
SITE_AUTH_PASSWORD=replace-with-a-long-random-password
SITE_AUTH_MODE=all
GITHUB_TOKEN=ghp_replace_with_repo_creation_token
GITHUB_REPOSITORY_VISIBILITY=private
JORMUNGAND_REPOSITORY=owner/repository
CODEX_BRIDGE_URL=https://codex-bridge.example.com
CODEX_BRIDGE_TOKEN=replace-with-codex-bridge-token
OPENCLAW_BRIDGE_URL=https://openclaw-bridge.example.com
OPENCLAW_BRIDGE_TOKEN=replace-with-openclaw-bridge-token
OPENCLAW_GATEWAY_TOKEN=replace-with-openclaw-gateway-token
# Shared full-access contract; later bridge/workflow consumers enforce it.
# Once wired, full mode disables agent sandboxing and workflow approval pauses.
# Site Basic Auth remains enabled.
JORMUNGAND_AGENT_PERMISSION_MODE=full
