{
  "$comment": "Device-first config for the local Codex bridge device. Keep tokens in .env.local or an OS secret store.",
  "schemaVersion": 1,
  "device": {
    "id": "codex-bridge-device",
    "name": "Local Codex Bridge Device",
    "repoRoot": "C:\\Users\\linder\\Documents\\harness框架\\repos\\jormungand",
    "permissionMode": "full",
    "runtimeSkills": {
      "enabled": true,
      "root": ".harness/runtime-skills",
      "cache": ".harness/cache/skills"
    }
  },
  "bridge": {
    "host": "127.0.0.1",
    "port": 4177,
    "protocolVersion": "harness-agent-bridge/v0.3",
    "completedRunTtlMs": 3600000,
    "tokenEnv": "HARNESS_BRIDGE_TOKEN"
  },
  "runtimes": {
    "codex": {
      "enabled": true,
      "command": "codex",
      "serviceTier": "fast",
      "sandbox": "workspace-write",
      "timeoutMs": 900000,
      "sessionRequestTimeoutMs": 120000
    },
    "lucky": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4198,
      "tokenEnv": "LUCKY_BRIDGE_TOKEN",
      "backend": {
        "url": "https://api.minimax.io/v1",
        "model": "MiniMax-M3",
        "tokenEnv": "LUCKY_BACKEND_TOKEN",
        "timeoutMs": 600000
      },
      "limits": {
        "toolIterationCap": 25,
        "toolCallTimeoutMs": 120000,
        "runCommandTimeoutMs": 300000,
        "maxReadBytes": 512000,
        "maxOutputBytes": 256000
      },
      "quotaStorePath": "data/lucky-quota.json"
    }
  },
  "routing": {
    "defaultRuntime": "codex",
    "luckyBridgeUrl": "http://127.0.0.1:4198"
  },
  "secrets": {
    "bridgeTokenEnv": "HARNESS_BRIDGE_TOKEN",
    "codexClientTokenEnv": "CODEX_BRIDGE_TOKEN",
    "luckyBridgeTokenEnv": "LUCKY_BRIDGE_TOKEN",
    "luckyBackendTokenEnv": "LUCKY_BACKEND_TOKEN"
  }
}
