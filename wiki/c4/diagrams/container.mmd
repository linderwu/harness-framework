flowchart LR
  %% Container
  operator["Operator<br/>Uses browser UI."]
  dashboard["Harness Dashboard<br/>Project selection, workflow launch, artifacts, approval gates."]
  api["Authenticated HTTP Boundary<br/>Public /health; site-authenticated UI, API, and /api/agent-health."]
  engine["Workflow Engine<br/>Creates/advances runs and coordinates gates."]
  bridge["Agent Bridge<br/>Normalizes Codex/OpenClaw/simulated executor calls."]
  resolver["Runtime Skill Resolver<br/>Resolves bridge protocol v0.3 skill bundles."]
  store["Workspace Store<br/>Configured data-dir persistence for SQLite and workflow JSON."]
  codex["Codex Bridge<br/>External execution bridge."]
  openclaw["OpenClaw Runtime<br/>Optional external executor."]
  github["GitHub<br/>Repository source/target."]
  operator -->|"operates"| dashboard
  dashboard -->|"authenticated fetch / mutate"| api
  api -->|"create/advance"| engine
  api -->|"read/write"| store
  engine -->|"invoke agents"| bridge
  engine -->|"resolve skills"| resolver
  engine -->|"persist artifacts"| store
  bridge -->|"POST agent-runs"| codex
  bridge -->|"bridge/A2A"| openclaw
  bridge -->|"ensure repo"| github
